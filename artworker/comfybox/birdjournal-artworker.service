# systemd unit for BirdJournal's art worker on comfybox (issue #68): /etc/systemd/system/birdjournal-artworker.service,
# installed by install-artworker-service.sh. It long-polls the art queue over outbound HTTPS and paints on the FLUX.3
# ComfyUI on loopback (port 8189); nothing listens and nothing reaches into the home network (ADR-0003).
# The AWS key, the queue, the buckets, the API and the worker token are in artworker.env (mode 600), which the art
# wizard writes (infra/scripts/art-wizard.sh); none of it is in this public repository.
[Unit]
Description=BirdJournal art worker (scene art on FLUX.3 Image Klein)
After=network-online.target comfyui-flux3.service
Wants=network-online.target comfyui-flux3.service

[Service]
User=matt
WorkingDirectory=/home/matt/birdjournal-art/repo/artworker
EnvironmentFile=/home/matt/birdjournal-art/artworker.env
ExecStart=/home/matt/birdjournal-art/repo/artworker/.venv/bin/python -m artworker
# A painting under way finishes before it stops (SIGTERM ends the loop after the current job).
TimeoutStopSec=180
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
