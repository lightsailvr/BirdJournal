diff --git a/BirdJournal/BirdJournal/Design/LaunchProbe.swift b/BirdJournal/BirdJournal/Design/LaunchProbe.swift
new file mode 100644
index 0000000..fbdaedc
--- /dev/null
+++ b/BirdJournal/BirdJournal/Design/LaunchProbe.swift
@@ -0,0 +1,10 @@
+import OSLog
+
+enum LaunchProbe {
+    nonisolated static func measure<T>(_ name: StaticString, _ work: () throws -> T) rethrows -> T {
+        let signposter = OSSignposter(subsystem: "com.matthewcelia.mybirdjournal", category: "launch")
+        let interval = signposter.beginInterval(name)
+        defer { signposter.endInterval(name, interval) }
+        return try work()
+    }
+}
