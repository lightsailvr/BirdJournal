# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.moved-aside
.swiftpm/
# Model and pack artifacts (downloaded by scripts/download-models.sh)
models/*
!models/manifest.json
!models/README.md
packbuilder/cache/
# Python
__pycache__/
.venv/
# macOS
.DS_Store

# Labeled test clips (downloaded by scripts/download-clips.sh)
fixtures/clips/

# Pack builder (packbuilder/): environment, download cache, pytest state. Built packs are fetched into packs/<id>/
# from GitHub Releases by scripts/download-pack.sh (packs/manifest.json pins them); the builder's zips go to build/packs/.
packbuilder/.venv/
packbuilder/.pytest_cache/
packbuilder/**/__pycache__/
packs/*
!packs/README.md
!packs/manifest.json
docs/My-Bird-Journal-Bird-Variants.zip
docs/MyBirdJournal_Icon_prompts_ChatGPT.txt

# Backend (backend/) and its stack (infra/): environments, pytest state, CDK output and the pinned CLI
backend/.venv/
backend/.pytest_cache/
infra/.venv/
infra/.pytest_cache/
infra/cdk.out/
infra/node_modules/

# Art worker (artworker/): environment, the content filter model (scripts/download-filter.sh), pytest state.
artworker/.venv/
artworker/models/
artworker/.pytest_cache/
artworker/**/__pycache__/
